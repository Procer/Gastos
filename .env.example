# Postgres
POSTGRES_USER=gastos
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=gastos
DB_HOST=postgres
DB_PORT=5432

# Azure AI Document Intelligence (OCR de imágenes y PDFs escaneados)
AZURE_DOC_INTEL_ENDPOINT=https://<tu-recurso>.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=

# LLM de clasificación (default: google / Gemini via Google AI Studio)
LLM_PROVIDER=google
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternativas, si cambias LLM_PROVIDER a "anthropic" u "openai":
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gmail - IMAP (para leer correos entrantes con comprobantes)
IMAP_HOST=imap.gmail.com
IMAP_USER=tu_correo@gmail.com
IMAP_APP_PASSWORD=
EMAIL_POLL_INTERVAL_SECONDS=300

# SMTP (para enviar alertas de error, puede ser la misma cuenta de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=tu_correo@gmail.com

# Telegram (canal de entrada adicional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_POLL_INTERVAL_SECONDS=10

# API de subida manual
UPLOAD_API_KEY=una_clave_random_larga

UPLOADS_DIR=/app/uploads
